/* Keep here changes of the base map style file only. */
@import("../../default/include/Roads.mapcss");

/* ~~~~ CYCLING STYLE — ROADS OVERRIDES ~~~~~
   Google Maps-like cased lines: a continuous contrasting casing underneath,
   with a colored blue stroke centered on top. The casing always stays
   continuous; the stroke is solid / dashed / dotted to encode the
   infrastructure type.

   Two blue intensities share one hue: dedicated (off-road) cycling
   infrastructure (@cycleway) is slightly stronger than road-attached
   cyclewaytag track/lane/shared_lane (@cycleway_road).

   Motorways and trunks are de-emphasized: cyclists rarely use them, so they
   recede into the base. The cycling layer gets the visual room to breathe.
*/

/* De-emphasize motorways and trunks from z7 onwards — cyclists rarely use
   them. Skip z6 where default already draws them at opacity 0.3 (the world
   view, where overriding to 0.5 would make them MORE visible). */
line|z7-[highway=motorway],
line|z7-[highway=trunk],
line|z10-[highway=motorway_link],
line|z10-[highway=trunk_link],
{opacity: 0.5;}

/* Promote dedicated cycleways to z11+ (default starts at z13) and designated
   shared paths/footways to z12+/z13+, so the cycling network is visible at
   city overview zoom. Designated paths/footways render solid, like dedicated
   cycleways: they are cycling infrastructure, and the solid/dashed/dotted
   distinction is reserved for cycleway=track/lane/shared_lane attached to a
   road. The stronger @cycleway blue + casing makes them stand out. */
line|z11-[highway=cycleway],
line|z12-[highway=path][bicycle=designated],
line|z13-[highway=footway][bicycle=designated],
{color: @cycleway; opacity: 1; dashes: none; linecap: round;
 casing-color: @cycleway_casing; casing-width: 1.5;}

line|z11[highway=cycleway],
{width: 3.6;}
line|z12[highway=cycleway],
{width: 4.2;}
line|z12[highway=path][bicycle=designated],
{width: 3.6;}
line|z13[highway=cycleway],
{width: 4.8;}
line|z13[highway=path][bicycle=designated],
line|z13[highway=footway][bicycle=designated],
{width: 3.9;}
line|z14[highway=footway][bicycle=designated],
{width: 4.2;}
line|z14[highway=cycleway],
{width: 5.4;}
line|z15[highway=cycleway],
{width: 6.3;}
line|z16-17[highway=cycleway],
{width: 7.8;}
line|z18-[highway=cycleway],
{width: 9.0;}

/* The base path/footway line is already solid @cycleway, so the inherited
   ::cycleline underline (a second, fainter blue line) is redundant. */
line|z14-[highway=path][bicycle=designated]::cycleline,
line|z15-[highway=footway][bicycle=designated]::cycleline,
{width: 0;}

/* Cycleway infrastructure attached to a road. Solid = track, dashed = lane,
   dotted = shared_lane, all in the same @cycleway_road blue over a continuous
   casing (the casing never inherits the stroke dashes). */
line|z13-[cyclewaytag=track],
line|z14-[cyclewaytag=lane],
line|z14-[cyclewaytag=shared_lane],
{color: @cycleway_road; opacity: 1; linecap: round;
 casing-color: @cycleway_casing; casing-width: 1.5; casing-dashes: none;}

line|z13[cyclewaytag=track],
{width: 4.2;}
line|z14[cyclewaytag=track],
{width: 4.8;}
line|z15[cyclewaytag=track],
{width: 5.7;}
line|z16-17[cyclewaytag=track],
{width: 6.9;}
line|z18-[cyclewaytag=track],
{width: 8.1;}

line|z14[cyclewaytag=lane],
{width: 4.5; dashes: 18,4.8;}
line|z15[cyclewaytag=lane],
{width: 4.8; dashes: 19.5,4.8;}
line|z16-17[cyclewaytag=lane],
{width: 6.0; dashes: 24,5.4;}
line|z18-[cyclewaytag=lane],
{width: 6.9; dashes: 27,6.0;}

line|z14[cyclewaytag=shared_lane],
{width: 4.2; dashes: 4.8,4.8;}
line|z15[cyclewaytag=shared_lane],
{width: 4.5; dashes: 4.8,4.8;}
line|z16-17[cyclewaytag=shared_lane],
{width: 5.7; dashes: 5.4,5.4;}
line|z18-[cyclewaytag=shared_lane],
{width: 6.6; dashes: 6.0,6.0;}
